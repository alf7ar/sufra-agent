# Copy to .env (or export in your shell). Never commit real values.
# Only needed for the LLM + voice demo; the MCP server and tests need no key.
OPENAI_API_KEY=
# Model used by the simulator host (any chat model with tool calling)
SUFRA_MODEL=gpt-5.4-mini
# Hard spend cap (USD) enforced by the simulator host
SUFRA_SPEND_CAP_USD=2
# Demo bearer token accepted by /mcp (defaults to "sufra-demo-token" if unset)
SUFRA_BEARER_TOKEN=
PORT=8787
